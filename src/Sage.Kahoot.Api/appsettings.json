    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60,
    "JoinPermitLimit": 20,
    "JoinWindowSeconds": 60
  },
  "Swagger": {
    "Enabled": false
  },
  "Seed": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}
