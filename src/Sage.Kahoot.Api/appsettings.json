{
  "Mongo": {
    "ConnectionString": "",
    "Database": "sage_kahoot",
    "HealthCheckTimeoutMs": 2000
  },
  "Auth": {
    "AdminUsername": "",
    "AdminPassword": "",
    "SigningKey": "",
    "Issuer": "sage-kahoot-api",
    "Audience": "sage-kahoot-web",
